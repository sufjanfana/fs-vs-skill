{
  "name": "fs-vs-skill",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -p .",
    "test:unit": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project unit",
    "test:it": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project e2e",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "eval": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs bin/eval.ts",
    "eval:rerun-failed": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs bin/eval-rerun-failed.ts",
    "eval:combine": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs bin/eval-combine.ts",
    "diagnose": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs bin/manual-diagnostic.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.143",
    "@anthropic-ai/sdk": "^0.96.0",
    "just-bash": "^3.0.1",
    "lru-cache": "^11.3.6",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
