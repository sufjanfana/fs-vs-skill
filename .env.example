ANTHROPIC_API_KEY=

# Eval-run DB connection. Point at the docs_ro read-only role on the live
# Arize docs Postgres. The Phase 1 smoke gate verifies an INSERT against this
# role fails (SQLSTATE 42501). docs_ro must have SELECT on doc_paths and
# doc_chunks — run scripts/grant-docs-ro.sql once as a privileged role to
# set that up.
PG_CONNECTION_STRING=postgresql://docs_ro:docs_ro@localhost:5432/docs_fs
